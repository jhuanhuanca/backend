# Copiá este archivo a /opt/vendedor/backend/.env en el VPS.
# No lo subas a Git. Generá claves nuevas (no uses las de tu PC).

APP_NAME=Vendedor Live
APP_ENV=production
ALLOWED_HOSTS=regissynkai.store,www.regissynkai.store

SECRET_KEY=CAMBIAR-cadena-larga-aleatoria-50-caracteres
FARM_API_KEY=CAMBIAR-otra-clave-distinta-para-la-granja

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=CAMBIAR-contraseña-fuerte

# PostgreSQL (recomendado). Usuario y clave los creás vos en el VPS.
DATABASE_URL=postgresql+asyncpg://vendedor:CAMBIAR-DB-PASS@127.0.0.1:5432/vendedor

# Alternativa MySQL / MariaDB:
# DATABASE_URL=mysql+aiomysql://vendedor:CAMBIAR-DB-PASS@127.0.0.1:3306/vendedor

PUBLIC_BASE_URL=https://regissynkai.store
CURRENCY=BOB
RESERVATION_MINUTES=10

# WhatsApp: número público para wa.me (Bolivia 591 + 76364961)
BUSINESS_WHATSAPP_E164=59176364961

# Estos tres salen del panel de Meta (no son el número 76364961):
WHATSAPP_TOKEN=EAAB-token-permanente-de-meta
WHATSAPP_PHONE_NUMBER_ID=id-numerico-del-numero-en-meta
WHATSAPP_APP_SECRET=app-secret-de-la-app-de-meta
WHATSAPP_VERIFY_TOKEN=CAMBIAR-token-que-inventas-para-el-webhook
WHATSAPP_SKIP_SIGNATURE=false
WHATSAPP_GRAPH_VERSION=v21.0

# El motor corre en el mismo VPS. Llamada interna (no hace falta pasar por internet).
MOTOR_IA_URL=http://127.0.0.1:8010
MOTOR_IA_API_KEY=CAMBIAR-misma-clave-que-en-motor-ia
MOTOR_IA_TIMEOUT=20

MOTOR_VISUAL_URL=http://127.0.0.1:8011
MOTOR_VISUAL_API_KEY=CAMBIAR-misma-clave-que-en-motor-visual
MOTOR_VISUAL_TIMEOUT=25
MOTOR_VISUAL_THRESHOLD=0.85
MOTOR_VISUAL_UNSURE=0.60
